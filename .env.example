# ─────────────────────────────────────────────────────────────────────────────
# CivicAlerts – configurazione. Copia questo file in ".env" e modificalo.
# ─────────────────────────────────────────────────────────────────────────────

# Indirizzo IP del server nella rete locale: è quello che digiterai sul telefono
# (in PowerShell: ipconfig → "Indirizzo IPv4").
SERVER_IP=192.168.1.50

# Password del database e della casella di prova Mailpit (utente: admin).
# Scegline due lunghe e diverse.
DB_PASSWORD=cambia-questa-password
MAILPIT_PASSWORD=cambia-anche-questa

# Utente amministratore creato al primo avvio (facoltativo).
# Indirizzo nei link delle email: con l'accesso da internet attivo usa https://app.civicalerts.it
# PUBLIC_URL=https://app.civicalerts.it

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Regole segnalazioni
REQUIRE_EMAIL_VERIFICATION=true   # conferma email obbligatoria alla registrazione
MAX_REPORTS_PER_DAY=5             # anti-spam: segnalazioni per utente nelle 24 ore
DUPLICATE_RADIUS_M=50             # stessa categoria entro questa distanza = stesso problema (la segnalazione parte comunque)
REMINDER_DAYS=15                  # dopo quanti giorni chiedere al cittadino se il problema è risolto (Comuni senza cruscotto)
MAX_GPS_ACCURACY_M=200            # rifiuta posizioni GPS meno precise di così
MAX_UPLOAD_MB=50

# ── Posta ────────────────────────────────────────────────────────────────────
# Lasciare commentato per la fase di test: tutte le email e le PEC finiscono in
# Mailpit (https://SERVER_IP/mailpit/) e NESSUN messaggio raggiunge i Comuni.
# Email ai cittadini (conferme, avvisi) — casella del dominio, es. Aruba:
# SMTP_HOST=smtps.aruba.it
# SMTP_PORT=465
# SMTP_USER=noreply@civicalerts.it
# SMTP_PASS=
# MAIL_FROM=CivicAlerts <noreply@civicalerts.it>
#
# PEC ai Comuni — casella PEC, es. Aruba:
# PEC_SMTP_HOST=smtps.pec.aruba.it
# PEC_SMTP_PORT=465
# PEC_SMTP_USER=segnalazioni@pec.it
# PEC_SMTP_PASS=
# PEC_FROM=CivicAlerts <segnalazioni@pec.it>

# Con la PEC reale, per un collaudo sicuro dirotta tutte le PEC a un tuo indirizzo:
# PEC_OVERRIDE_TO=tua-pec@pec.it
