# CivicAlerts – produzione. Caddy ottiene e rinnova da solo il certificato
# HTTPS (Let's Encrypt) per il dominio: nessun certificato da installare
# sui telefoni.
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy app:3000
}
