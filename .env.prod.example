# ─────────────────────────────────────────────────────────────────────────────
# CivicAlerts – configurazione di PRODUZIONE (server cloud).
# Sul server: cp .env.prod.example .env  e poi  nano .env
# ─────────────────────────────────────────────────────────────────────────────

# Usa automaticamente il file di produzione con i normali comandi docker compose
COMPOSE_FILE=docker-compose.prod.yml

# Dominio dell'app (senza https:// e senza www)
DOMAIN=civicalerts.it
# Email per gli avvisi di Let's Encrypt sui certificati
ACME_EMAIL=admin@civicalerts.it

# Password del database: lunga e casuale (es. openssl rand -base64 24)
DB_PASSWORD=

# Amministratore creato al primo avvio
ADMIN_EMAIL=admin@civicalerts.it
ADMIN_PASSWORD=

# ── Email ai cittadini: una casella del dominio (Aruba) ──────────────────────
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_USER=noreply@civicalerts.it
SMTP_PASS=
MAIL_FROM="CivicAlerts <noreply@civicalerts.it>"

# ── Segnalazioni ai Comuni: casella PEC (Aruba) ──────────────────────────────
PEC_SMTP_HOST=smtps.pec.aruba.it
PEC_SMTP_PORT=465
PEC_SMTP_USER=segnalazioni@pec.it
PEC_SMTP_PASS=
PEC_FROM="CivicAlerts <segnalazioni@pec.it>"

# COLLAUDO: finché è impostato, TUTTE le PEC arrivano a questo indirizzo invece
# che ai Comuni. Svuotalo solo quando sei pronto per l'invio reale.
PEC_OVERRIDE_TO=la-tua-email@esempio.it

# Regole segnalazioni
REQUIRE_EMAIL_VERIFICATION=true
MAX_REPORTS_PER_DAY=5
DUPLICATE_RADIUS_M=50
REMINDER_DAYS=15
MAX_GPS_ACCURACY_M=200
MAX_UPLOAD_MB=50

# Contatto richiesto dalla policy del servizio indirizzi OpenStreetMap (Nominatim)
NOMINATIM_EMAIL=admin@civicalerts.it
